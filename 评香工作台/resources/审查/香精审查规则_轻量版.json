{
  "version": "lite-0.1",
  "status": "内部工作流草案；法规路由继承v0.9的待核验线索，不是可执行法律限值",
  "category_policy": {
    "application_category": "独立推香证据标签，不用于生成审查要求",
    "review_category": "单层18个规范类；不确定时评香确认；宠物/婴童标记额外用途并合规确认，不强制归类",
    "market": "具体国家或地区，可多选；未知保留待确认"
  },
  "metric_dictionary": {
    "P1": {
      "name": "强度",
      "department": "application",
      "scope": "application",
      "record_hint": "在指定阶段、载体、位置和条件下感知到的香气大小。"
    },
    "P2": {
      "name": "爆发",
      "department": "application",
      "scope": "application",
      "record_hint": "开盖、喷洒、起泡或启动后的早期释放。"
    },
    "P3": {
      "name": "扩散",
      "department": "application",
      "scope": "application",
      "record_hint": "在给定空间或人体周围的可感知范围。"
    },
    "P4": {
      "name": "特征保持",
      "department": "application",
      "scope": "application",
      "record_hint": "进入成品并实际使用后，核心气味特征是否保留。"
    },
    "P5": {
      "name": "平衡",
      "department": "application",
      "scope": "application",
      "record_hint": "主体、辅助及甜酸粉木等关系是否符合目标。"
    },
    "P6": {
      "name": "层次",
      "department": "application",
      "scope": "application",
      "record_hint": "同一载体上随时间变化的香气特征。"
    },
    "P7": {
      "name": "留香",
      "department": "application",
      "scope": "application",
      "record_hint": "指定载体在指定时点仍可感知的香气及质量。"
    },
    "P8": {
      "name": "均匀性",
      "department": "application",
      "scope": "application",
      "record_hint": "测点之间或使用周期内的强度一致性。"
    },
    "P9": {
      "name": "再释放",
      "department": "application",
      "scope": "application",
      "record_hint": "摩擦、再润湿或运动等动作引起的香气变化。"
    },
    "P10": {
      "name": "遮盖",
      "department": "application",
      "scope": "application",
      "record_hint": "目标异味感知是否下降以及混合气味是否可接受。"
    },
    "P11": {
      "name": "气味舒适",
      "department": "application",
      "scope": "application",
      "record_hint": "实际使用场景中的突兀、闷、过强等主观感受。"
    },
    "P12": {
      "name": "口感/余味",
      "department": "application",
      "scope": "application",
      "record_hint": "先取得口腔/口唇用途安全授权"
    },
    "P13": {
      "name": "起香时间/有效释放周期",
      "department": "application",
      "scope": "application",
      "record_hint": "区分感官周期与物料消耗"
    },
    "P14": {
      "name": "异味返味",
      "department": "application",
      "scope": "application",
      "record_hint": "与P10同批测试，按时点判断"
    },
    "Q_SPEC": {
      "name": "原液规格与理化",
      "department": "quality",
      "scope": "formula_or_batch",
      "record_hint": "外观、颜色、密度、折光率等按规格记录"
    },
    "Q_FLASH": {
      "name": "闪点",
      "department": "quality",
      "scope": "formula_or_finished",
      "record_hint": "实际数值、单位、方法；原液和成品分开"
    },
    "Q_COMPAT": {
      "name": "加香相容性",
      "department": "quality",
      "scope": "application",
      "record_hint": "溶解、析出、分层、澄清、pH、黏度等按基料选择"
    },
    "Q_STABILITY": {
      "name": "稳定性",
      "department": "quality",
      "scope": "application_or_formula",
      "record_hint": "温度、光照、周期、变色、析出、气味变化；原液和成品分开"
    },
    "Q_SPECIAL": {
      "name": "特殊应用质量检测",
      "department": "quality",
      "scope": "application_or_finished",
      "record_hint": "子项必填：加工耐受、包材、燃烧安全、释放速率等；不同子项不互认"
    },
    "Q_COA": {
      "name": "COA",
      "department": "quality",
      "scope": "batch",
      "record_hint": "批次、规格、检验结果及报告"
    },
    "R_IFRA": {
      "name": "IFRA核查及文件",
      "department": "compliance",
      "scope": "formula_use",
      "record_hint": "具体终用途、标准版本、最大用量、实际用量、文件；核查和出文件可分开"
    },
    "R_SDS": {
      "name": "SDS及运输资料",
      "department": "compliance",
      "scope": "formula_market",
      "record_hint": "语言、市场、版本、报告；运输分类单独子项"
    },
    "R_ALLERGEN": {
      "name": "过敏原核查及资料",
      "department": "compliance",
      "scope": "formula_or_product_market",
      "record_hint": "名单版本、组分数据、阈值口径、成品添加量、报告"
    },
    "R_MARKET": {
      "name": "销售地法规核查",
      "department": "compliance",
      "scope": "formula_use_market",
      "record_hint": "实际终产品、国家、适用规则版本、核查结论和香精支持文件"
    },
    "R_EXTRA": {
      "name": "特殊限制与认证",
      "department": "compliance",
      "scope": "formula_use_market",
      "record_hint": "客户限制清单、清真、食品/口腔适用、儿童宠物、特殊宣称等按具体子项核查"
    }
  },
